[26.972268, "o", "┌──────────────┬──────────────────────────────────────────────────────────────────────────────────────────────┐\r\n│ Tool         │ Description                                                                                  │\r\n├──────────────┼──────────────────────────────────────────────────────────────────────────────────────────────┤\r\n│ notes.read   │ Read a UTF-8 note inside the configured folder.                                              │\r\n├──────────────┼──────────────────────────────────────────────────────────────────────────────────────────────┤\r\n│ notes.search │ Find case-insensitive matching Markdown lines, with relative paths and 1-based line numbers. │\r\n├──────────────┼──────────────────────────────────────────────────────────────────────────────────────────────┤\r\n│ notes.write  │ Append content and a trailing newline, creating a note if absent; never overwrite.           │\r\n└──────────────┴───────────────────────"]
[27.155138, "o", "───────────────────────────────────────────────────────────────────────┘\r\n"]
[32.155603, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[90mLOCAL AI AGENT HARNESS  /  v0.1.0  /  REAL CLI RECORDING\u001b[0m\r\n\u001b[1m\u001b[96m03  A Node policy plugin composes with Python.\u001b[0m\r\n\u001b[90mThe guard hook rewrites tool input before notes.write executes. The token is synthetic.\u001b[0m\r\n\r\n"]
