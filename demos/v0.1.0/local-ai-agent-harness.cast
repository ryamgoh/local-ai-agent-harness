[112.603408, "o", "┌──────────────┬──────────────────────────────────────────────────────────────────────────────────────────────┐\r\n│ Tool         │ Description                                                                                  │\r\n├──────────────┼──────────────────────────────────────────────────────────────────────────────────────────────┤\r\n│ notes.read   │ Read a UTF-8 note inside the configured folder.                                              │\r\n├──────────────┼──────────────────────────────────────────────────────────────────────────────────────────────┤\r\n│ notes.search │ Find case-insensitive matching Markdown lines, with relative paths and 1-based line numbers. │\r\n├──────────────┼──────────────────────────────────────────────────────────────────────────────────────────────┤\r\n│ notes.write  │ Append content and a trailing newline, creating a note if absent; never overwrite.           │\r\n└──────────────┴───────────────────────"]
[112.781308, "o", "───────────────────────────────────────────────────────────────────────┘\r\n"]
[116.781874, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[90mLOCAL AI AGENT HARNESS  /  v0.1.0  /  REAL CLI RECORDING\u001b[0m\r\n\u001b[1m\u001b[96m07  Local-first host. Language-independent plugins.\u001b[0m\r\n\u001b[90mMCP tool discovery + JSON hooks + one guarded execution gateway.\u001b[0m\r\n\r\n"]
[118.782143, "o", "\u001b[92mDemonstrated on the actual v0.1.0 release:\u001b[0m\r\n\r\n  Python notes adds three MCP tools.\r\n  Node guard redacts and denies tool calls.\r\n  Live OpenRouter inference finds the saved note.\r\n  Disable removes tools; enable restores them.\r\n\r\n\u001b[90mModel is hosted in this recording; the host and plugins run locally.\r\nOllama is supported but not demonstrated here.\r\nDeclared permissions are consent information, not an OS sandbox.\r\n\r\nPrivate repository: ryamgoh/local-ai-agent-harness\r\nInstall guide: docs/INSTALL.md    Release: v0.1.0\r\nRecorded commands are real. Command typing is scripted for readability.\r\n\u001b[0m"]
[125.782479, "o", "\u001b[?25h"]
