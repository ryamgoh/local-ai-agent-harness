{
  "name": "local-ai-agent-harness",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Local AI agent harness with external MCP tool and command-hook plugins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryamgoh/local-ai-agent-harness.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "pnpm --filter guard build && node scripts/build-fixtures.mjs && tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e",
    "test:coverage": "vitest run --coverage",
    "test:plugins": "uv run --with pytest --with \"mcp>=2.3,<3\" pytest plugins/notes/tests -q && node --test plugins/guard/test/*.test.mjs",
    "test:version": "node --test test/release-version.test.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:release": "node scripts/smoke-release.mjs",
    "version:check": "node scripts/check-version.mjs",
    "version:set": "node scripts/version.mjs",
    "lint": "eslint packages test scripts --max-warnings 0 && prettier --check packages test scripts schema README.md",
    "format": "prettier --write packages test scripts schema README.md",
    "schema": "tsx scripts/gen-schema.ts",
    "harness": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.0",
    "@types/proper-lockfile": "^4.1.0",
    "@types/semver": "^7.0.0",
    "@types/write-file-atomic": "^4.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "execa": "^10.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.0",
    "zod": "^4.2.0"
  }
}
